# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_ORG_ID=org-your_organization_id_here

# API Configuration
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MAX_TOKENS=150
OPENAI_TEMPERATURE=0.7
OPENAI_TIMEOUT=10000

# Rate Limiting Configuration
# Adjust based on your OpenAI plan limits
RATE_LIMIT_REQUESTS_PER_MINUTE=10
RATE_LIMIT_WINDOW_MS=60000

# CORS Configuration
# Add your frontend domains here
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com
CORS_CREDENTIALS=true

# Security Settings
# Generate strong random strings for these
JWT_SECRET=your_jwt_secret_minimum_32_characters
SESSION_SECRET=your_session_secret_minimum_32_characters
ENCRYPTION_KEY=your_encryption_key_32_characters

# Application Settings
NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001

# Feature Flags
ENABLE_AI_FEATURES=true
ENABLE_RATE_LIMITING=true
ENABLE_LOGGING=true
ENABLE_ANALYTICS=false

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Database Configuration (optional)
# Uncomment if you need persistent storage
# DATABASE_URL=postgresql://username:password@localhost:5432/portfolio_db
# REDIS_URL=redis://localhost:6379

# Third-party Services (optional)
# Uncomment if you want to add analytics or monitoring
# ANALYTICS_API_KEY=your_analytics_key_here
# MONITORING_API_KEY=your_monitoring_key_here

# Development Settings
DEBUG_MODE=true
MOCK_AI_RESPONSES=false

# Setup Instructions:
# 1. Copy this file to .env
# 2. Replace all placeholder values with your actual keys
# 3. Never commit .env to version control
# 4. Make sure .env is in your .gitignore file
